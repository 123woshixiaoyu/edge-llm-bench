# Third-party source and build artifacts
llama.cpp/
build/
cmake-build-*/

# Local model files are too large for git and may have separate licenses
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# Raw logs can be regenerated from CSV summaries
results/raw/logs/
results/raw/*.log
results/raw/*.pid
results/raw/*dryrun*.csv
runtime_logs/
runtime_data/

# Python/editor noise
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
.DS_Store
.idea/
.vscode/

# Never commit credentials
*token*
*secret*
